# Copy to .env (never committed) if you want these set for your shell/IDE.
# This tool needs NO API keys. An AI assistant's API key belongs in your IDE's
# own settings, never in this repository.

# Which DWG converter to use: libredwg | oda. Unset = first one available.
DWG_CONVERTER=
# Path to ODAFileConverter(.exe) if you use ODA and it is not on PATH.
ODA_FC_PATH=
# Where converted DXFs are cached. Default: ~/.cache/dwg-text-checks
DWG_CACHE_DIR=
# Override plan-view detection with explicit viewport ids, e.g. 3,6
DWG_PLAN_VIEWPORTS=
